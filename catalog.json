    {
      "id": "pyrite",
      "name": "Pyrite",
      "tagline": "Blocky, game-ready 3D assets from a prompt.",
      "kind": "source",
      "sources": [
        {
          "repo": "Labyrica/pyrite",
          "tagPrefix": "v"
        }
      ],
      "source": {
        "locate": [
          {
            "json": "~/Pyrite/mcp-entry.json",
            "pointer": "/args/0",
            "up": 2
          }
        ],
        "marker": "dist/pyrite.mjs",
        "stop": [
          "node",
          "dist/pyrite.mjs",
          "stop"
        ],
        "build": [
          [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ],
          [
            "pnpm",
            "build"
          ]
        ]
      }
    },
