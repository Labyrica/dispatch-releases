{
  "schema": 1,
  "apps": [
    {
      "id": "hightower",
      "name": "Hightower",
      "tagline": "Every git repo on your machine, in one window.",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNDFGQUNFOEQ4M0NDQwpSV1RNUE5qb3JCOFVBYUZsdWtlbmNJU0JWTmo3NFZrRFRkeWFsdmIvVDdBcEJlbkswVUUxY3k5cQo=",
      "sources": [
        { "repo": "Labyrica/hightower-releases" },
        { "repo": "Labyrica/hightower" }
      ],
      "windows": {
        "uninstallKeys": ["Hightower"],
        "exe": "hightower.exe",
        "assets": ["*_x64-setup.exe"],
        "dataDirs": ["%APPDATA%/Hightower", "%LOCALAPPDATA%/com.hightower.app"]
      },
      "macos": {
        "bundleId": "com.hightower.app",
        "appNames": ["Hightower.app"],
        "assets": ["*_{arch}.app.tar.gz"],
        "dataDirs": [
          "~/Library/Application Support/Hightower",
          "~/Library/Application Support/com.hightower.app",
          "~/Library/Caches/com.hightower.app",
          "~/Library/WebKit/com.hightower.app"
        ]
      }
    },
    {
      "id": "cascade",
      "name": "Cascade",
      "tagline": "Drag an APK onto a phone or headset.",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQzk1MEJDQTIwNjUzN0UKUldSK1V3YWl2RkRKV3V4TkJZOGNHUzV5UndwbXBySUpsOFdZL2MwT0wyaUkxeVBHdXBSOFRMQlIK"
    },
    {
      "id": "pyrite",
      "name": "Pyrite",
      "tagline": "Blocky, game-ready 3D assets from a prompt.",
      "kind": "bundle",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNzUzNDA3NkFFRUE0NjUKUldSbHBPNXFCelIxSHk5Nm5ONmdSQktyTlBxU1RqK2x0K0FlRGdzcG95Wmlndk9XVGZXWXhkME8K",
      "bundle": {
        "entry": "dist/pyrite.mjs",
        "runtime": { "command": "node", "name": "Node.js", "minMajor": 20, "download": "https://nodejs.org/en/download" },
        "assets": {
          "windows": ["*_windows-x64.zip"],
          "macos": ["*_macos-{arch}.zip"]
        },
        "stop": ["node", "dist/pyrite.mjs", "stop"],
        "postInstall": [["node", "dist/pyrite.mjs", "shortcut"]],
        "preUninstall": [["node", "dist/pyrite.mjs", "shortcut", "--remove"]],
        "dataDirs": ["~/Pyrite"]
      },
      "source": {
        "locate": [{ "json": "~/Pyrite/mcp-entry.json", "pointer": "/args/0", "up": 2 }],
        "marker": "dist/pyrite.mjs",
        "stop": ["node", "dist/pyrite.mjs", "stop"],
        "build": [
          ["pnpm", "install", "--frozen-lockfile"],
          ["pnpm", "build"]
        ]
      }
    },
    {
      "id": "foundry-godot",
